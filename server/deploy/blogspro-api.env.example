# /etc/blogspro-api.env (owner root, group blogspro-api, mode 0640)
SITE_ORIGIN=https://blogspro.in
DB_PATH=/var/lib/blogspro-api/blogspro.db
# Comma-separated. Admin applies only when Google/GitHub has verified the address.
ADMIN_EMAILS=you@example.com
# Google Cloud Console → Credentials → OAuth client. Redirect URI: https://blogspro.in/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub → Settings → Developer settings → OAuth Apps. Callback: https://blogspro.in/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Relay mode (used while the client secrets live only on the blogspro-auth worker):
# leave the *_CLIENT_SECRET values empty and set both lines below. The provider then
# returns to the worker's registered callback, the worker exchanges the code and sends
# back a signed assertion to /auth/bridge. Same secret as the worker's OAUTH_BRIDGE_SECRET.
# Filling in a *_CLIENT_SECRET switches that provider back to the direct flow.
OAUTH_BRIDGE_ORIGIN=https://blogspro-auth.abhishek-dutta1996.workers.dev
OAUTH_BRIDGE_SECRET=
