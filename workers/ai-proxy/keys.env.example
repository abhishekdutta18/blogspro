# Paste each provider key after its "=" (no quotes, no spaces), save, then run:
#   npm run push-keys
# The keys are uploaded to the blogspro-ai-proxy worker as Cloudflare secrets and then
# cleared from this file. Leave a line empty to keep whatever the proxy already has.
# This file (keys.env) is gitignored; keys.env.example is the committed template.

# https://console.groq.com/keys (free tier is enough)
GROQ_API_KEY=
# https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_KEY=
