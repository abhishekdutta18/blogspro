---
/**
 * ResearchArchive — the full index of pieces as a dated list,
 * with client-side keyword search and category filter (no network calls).
 */
import { getArticlesNewestFirst, getCategories } from '../data/articles';

const entries = getArticlesNewestFirst();
const categories = getCategories();
---

<section id="research" class="pt-12 scroll-mt-6" aria-labelledby="research-heading">
  <div class="section-head">
    <h2 id="research-heading" class="section-title">Research</h2>
    <span class="text-sm text-ink-3 num" id="archiveCount">{entries.length} pieces</span>
  </div>

  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
    <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm" role="group" aria-label="Filter by category">
      <button type="button" class="archive-filter" data-category="all" aria-pressed="true">All</button>
      {categories.map(category => (
        <button type="button" class="archive-filter" data-category={category} aria-pressed="false">{category}</button>
      ))}
    </div>
    <label class="relative md:w-64">
      <span class="sr-only">Search research</span>
      <input
        type="search"
        id="archiveSearch"
        placeholder="Search titles, topics, tags"
        autocomplete="off"
        class="w-full bg-transparent border-0 border-b border-rule-strong/40 focus:border-accent px-0 py-1.5 text-sm placeholder:text-ink-3 focus:outline-none focus:ring-0"
      />
    </label>
  </div>

  <ol class="divide-y divide-rule border-y border-rule" id="archiveList">
    {entries.map(article => (
      <li
        class="archive-item grid gap-x-8 gap-y-1 py-5 sm:grid-cols-[7.5rem_minmax(0,1fr)]"
        data-category={article.category}
        data-search={`${article.title} ${article.excerpt} ${article.tags.join(' ')}`.toLowerCase()}
      >
        <div class="text-xs text-ink-3 sm:pt-1.5 num">{article.date}</div>
        <div>
          <div class="kicker">{article.category}</div>
          <h3 class="mt-1 font-serif text-xl sm:text-[1.4rem] font-semibold leading-snug tracking-tight">
            <a href={`/p/${article.slug}.html`} class="headline-link">{article.title}</a>
          </h3>
          <p class="mt-1.5 text-[0.95rem] text-ink-2 leading-relaxed max-w-measure">{article.excerpt}</p>
          <p class="mt-2 text-xs text-ink-3">{article.readTime}</p>
        </div>
      </li>
    ))}
  </ol>

  <div id="archiveEmpty" class="hidden py-10 text-ink-2" role="status">
    Nothing matches that search.
    <button type="button" id="archiveReset" class="ml-1 text-accent underline underline-offset-4">Clear filters</button>
  </div>
</section>

<style>
  /* `.grid` would otherwise beat the [hidden] attribute (same specificity, later in the cascade). */
  .archive-item[hidden] { display: none; }
  .archive-filter {
    color: var(--ink-2);
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
  }
  .archive-filter:hover { color: var(--ink); }
  .archive-filter[aria-pressed='true'] {
    color: var(--ink);
    font-weight: 600;
    border-bottom-color: var(--accent);
  }
</style>

<script is:inline>
  (() => {
    const input = document.getElementById('archiveSearch');
    const filters = document.querySelectorAll('.archive-filter');
    const items = document.querySelectorAll('.archive-item');
    const empty = document.getElementById('archiveEmpty');
    const count = document.getElementById('archiveCount');
    const reset = document.getElementById('archiveReset');
    if (!input || !empty || !count) return;

    let category = 'all';

    const apply = () => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;
      items.forEach(item => {
        const matchesCategory = category === 'all' || item.dataset.category === category;
        const matchesQuery = !query || (item.dataset.search || '').includes(query);
        const show = matchesCategory && matchesQuery;
        item.hidden = !show;
        if (show) visible += 1;
      });
      count.textContent = `${visible} ${visible === 1 ? 'piece' : 'pieces'}`;
      empty.classList.toggle('hidden', visible > 0);
    };

    const setCategory = next => {
      category = next;
      filters.forEach(button => {
        button.setAttribute('aria-pressed', String(button.dataset.category === next));
      });
      apply();
    };

    input.addEventListener('input', apply);
    filters.forEach(button => button.addEventListener('click', () => setCategory(button.dataset.category || 'all')));
    reset?.addEventListener('click', () => {
      input.value = '';
      setCategory('all');
    });
  })();
</script>
