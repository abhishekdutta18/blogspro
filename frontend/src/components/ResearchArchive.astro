---
/**
 * ResearchArchive — the full index of pieces as a dated list, with client-side keyword search, category
 * filter and pagination of PAGE_SIZE pieces per page (no network calls). Every piece stays in the HTML, so
 * search engines and readers without JavaScript still get the whole list; the pager only hides the rest.
 */
import { getArticlesNewestFirst, getCategories } from '../data/articles';

const entries = getArticlesNewestFirst();
const categories = getCategories();
---

<section id="research" class="pt-12 scroll-mt-6" aria-labelledby="research-heading">
  <div class="section-head">
    <h2 id="research-heading" class="section-title">Research</h2>
    <span class="text-sm text-ink-3 num" id="archiveCount">{entries.length} pieces</span>
  </div>

  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
    <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm" role="group" aria-label="Filter by category">
      <button type="button" class="archive-filter" data-category="all" aria-pressed="true">All</button>
      {categories.map(category => (
        <button type="button" class="archive-filter" data-category={category} aria-pressed="false">{category}</button>
      ))}
    </div>
    <label class="relative md:w-64">
      <span class="sr-only">Search research</span>
      <input
        type="search"
        id="archiveSearch"
        placeholder="Search titles, topics, tags"
        autocomplete="off"
        class="w-full bg-transparent border-0 border-b border-rule-strong/40 focus:border-accent px-0 py-1.5 text-sm placeholder:text-ink-3 focus:outline-none focus:ring-0"
      />
    </label>
  </div>

  <ol class="divide-y divide-rule border-y border-rule" id="archiveList">
    {entries.map(article => (
      <li
        class="archive-item grid gap-x-8 gap-y-1 py-5 sm:grid-cols-[7.5rem_minmax(0,1fr)]"
        data-category={article.category}
        data-search={`${article.title} ${article.excerpt} ${article.tags.join(' ')}`.toLowerCase()}
      >
        <div class="text-xs text-ink-3 sm:pt-1.5 num">{article.date}</div>
        <div>
          <div class="kicker">{article.category}</div>
          <h3 class="mt-1 font-serif text-xl sm:text-[1.4rem] font-semibold leading-snug tracking-tight">
            <a href={`/p/${article.slug}.html`} class="headline-link">{article.title}</a>
          </h3>
          <p class="mt-1.5 text-[0.95rem] text-ink-2 leading-relaxed max-w-measure">{article.excerpt}</p>
          <p class="mt-2 text-xs text-ink-3">{article.readTime}</p>
        </div>
      </li>
    ))}
  </ol>

  <nav class="mt-6 flex flex-wrap items-center justify-between gap-3 text-sm" aria-label="Research pages" id="archivePager" hidden>
    <button type="button" class="archive-page" data-page-step="-1">← Newer</button>
    <ol class="flex flex-wrap items-center gap-1" id="archivePages"></ol>
    <button type="button" class="archive-page" data-page-step="1">Older →</button>
  </nav>

  <div id="archiveEmpty" class="hidden py-10 text-ink-2" role="status">
    Nothing matches that search.
    <button type="button" id="archiveReset" class="ml-1 text-accent underline underline-offset-4">Clear filters</button>
  </div>
</section>

<style>
  /* `.grid` would otherwise beat the [hidden] attribute (same specificity, later in the cascade). */
  .archive-item[hidden] { display: none; }
  .archive-filter {
    color: var(--ink-2);
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
  }
  .archive-filter:hover { color: var(--ink); }
  #archivePager:not([hidden]) { display: flex; }
  /* :global because the numbered buttons are created in the script, outside Astro's style scoping. */
  :global(.archive-page) { min-width: 2.25rem; padding: 0.35rem 0.6rem; color: var(--ink-2); border: 1px solid transparent; }
  :global(.archive-page:hover:not(:disabled)) { color: var(--ink); border-color: var(--rule); }
  :global(.archive-page:disabled) { opacity: 0.4; cursor: default; }
  :global(.archive-page[aria-current='page']) { color: var(--ink); font-weight: 600; border-color: var(--accent); }
  .archive-filter[aria-pressed='true'] {
    color: var(--ink);
    font-weight: 600;
    border-bottom-color: var(--accent);
  }
</style>

<script>
  import { clampPage, pageCount, pageList, pageRange } from '../lib/paginate.js';

  const PAGE_SIZE = 5;
  const section = document.getElementById('research');
  const input = document.getElementById('archiveSearch');
  const filters = [...document.querySelectorAll('.archive-filter')];
  const items = [...document.querySelectorAll('.archive-item')];
  const empty = document.getElementById('archiveEmpty');
  const count = document.getElementById('archiveCount');
  const pager = document.getElementById('archivePager');
  const pageButtons = document.getElementById('archivePages');
  const [newer, older] = pager ? [...pager.querySelectorAll('[data-page-step]')] : [];

  if (section && input && empty && count && pager && pageButtons) {
    const state = { category: 'all', page: 1 };

    const matching = () => {
      const query = input.value.trim().toLowerCase();
      return items.filter((item) => (state.category === 'all' || item.dataset.category === state.category)
        && (!query || (item.dataset.search || '').includes(query)));
    };

    function pageButton(page) {
      const li = document.createElement('li');
      if (page === 'gap') {
        li.className = 'px-1 text-ink-3';
        li.textContent = '…';
        return li;
      }
      const button = Object.assign(document.createElement('button'), { type: 'button', className: 'archive-page num', textContent: String(page) });
      button.setAttribute('aria-label', `Page ${page}`);
      if (page === state.page) button.setAttribute('aria-current', 'page');
      button.addEventListener('click', () => go(page));
      li.append(button);
      return li;
    }

    function render() {
      const shown = matching();
      const pages = pageCount(shown.length, PAGE_SIZE);
      state.page = clampPage(state.page, shown.length, PAGE_SIZE);
      const [start, end] = pageRange(state.page, shown.length, PAGE_SIZE);
      const onPage = new Set(shown.slice(start, end));
      items.forEach((item) => { item.hidden = !onPage.has(item); });
      count.textContent = `${shown.length} ${shown.length === 1 ? 'piece' : 'pieces'}`
        + (pages > 1 ? ` · page ${state.page} of ${pages}` : '');
      empty.classList.toggle('hidden', shown.length > 0);
      pager.hidden = pages < 2;
      newer.disabled = state.page === 1;
      older.disabled = state.page === pages;
      pageButtons.replaceChildren(...pageList(state.page, pages).map(pageButton));
    }

    // A page change keeps the reader at the top of the list rather than wherever the pager was.
    function go(page) {
      state.page = page;
      render();
      if (section.getBoundingClientRect().top < 0) section.scrollIntoView({ block: 'start' });
    }

    const restart = () => { state.page = 1; render(); };
    const setCategory = (next) => {
      state.category = next;
      filters.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.category === next)));
      restart();
    };

    input.addEventListener('input', restart);
    filters.forEach((button) => button.addEventListener('click', () => setCategory(button.dataset.category || 'all')));
    newer.addEventListener('click', () => go(state.page - 1));
    older.addEventListener('click', () => go(state.page + 1));
    document.getElementById('archiveReset')?.addEventListener('click', () => {
      input.value = '';
      setCategory('all');
    });
    render();
  }
</script>
