---
/**
 * MarketStrip — one quiet row of headline figures under the masthead.
 * Built from a dated snapshot (marketsAsOf); in the browser, /data/markets.json replaces the figures and
 * the label (see lib/markets.js). Without it the snapshot stays, labelled with its own date.
 */
import { marketAssets, marketsAsOf } from '../data/marketData';
import { formatIsoDate } from '../lib/format';

const STRIP_SYMBOLS = ['NSE:NIFTY', 'BSE:SENSEX', 'NSE:BANKNIFTY', 'USDINR', 'US10Y', 'GOLD', 'USOIL', 'SPX'];
const items = STRIP_SYMBOLS
  .map(symbol => marketAssets.find(asset => asset.symbol === symbol))
  .filter(asset => asset !== undefined);
---

<div class="border-b border-rule overflow-x-auto" aria-label="Market figures">
  <ul class="flex gap-6 py-2.5 text-xs whitespace-nowrap">
    <li class="text-ink-3" data-markets-label>Close, {formatIsoDate(marketsAsOf)}</li>
    {items.map(asset => (
      <li class="flex gap-1.5 num" data-market-symbol={asset.symbol}>
        <span class="text-ink-2">{asset.name}</span>
        <span class="font-mono" data-field="price">{asset.price}</span>
        <span class={`font-mono ${asset.isPositive ? 'text-up' : 'text-down'}`} data-field="change">{asset.change}</span>
      </li>
    ))}
  </ul>
</div>

<script>
  import { loadLiveMarkets } from '../lib/markets.js';
  loadLiveMarkets();
</script>
