---
/**
 * PolicyCalendar — India macro and policy: headline MoSPI indicators as tiles, RBI policy rates and recent
 * RBI releases, beside this week's high-impact releases. Bond yields live in YieldCurve.astro (CCIL only),
 * so this section deliberately shows none.
 * Everything is loaded in the browser from /data/policy.json (see lib/policy.js), which the server builds
 * from rbi.org.in, MoSPI's API and the Forex Factory calendar feed. Nothing here is written by hand, so
 * the section shows a loading state until the data arrives.
 */
---

<section id="policy" class="pt-16 scroll-mt-6" aria-labelledby="policy-heading">
  <div class="section-head">
    <h2 id="policy-heading" class="section-title">India macro and policy</h2>
  </div>

  <dl class="mb-10 grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-4" data-macro-tiles>
    <div class="col-span-full text-sm text-ink-3">Loading India macro data…</div>
  </dl>

  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
    <div>
      <h3 class="font-serif text-xl font-semibold">RBI policy rates</h3>
      <p class="mt-1 text-xs text-ink-3" data-policy-rbi-label>Loading from rbi.org.in…</p>
      <dl class="mt-4 divide-y divide-rule text-sm" data-policy-rates></dl>

      <h3 class="mt-8 text-xs uppercase tracking-[0.14em] text-ink-3">Latest from RBI</h3>
      <ul class="mt-2 divide-y divide-rule text-sm" data-policy-releases></ul>
    </div>

    <div class="overflow-x-auto">
      <h3 class="font-serif text-xl font-semibold">High-impact releases this week</h3>
      <p class="mt-1 text-xs text-ink-3" data-policy-calendar-label>Loading calendar…</p>
      <table class="mt-4 w-full text-sm">
        <thead>
          <tr class="border-b border-rule-strong text-left text-xs uppercase tracking-wider text-ink-3">
            <th scope="col" class="py-2 pr-4 font-medium">Time (IST)</th>
            <th scope="col" class="py-2 pr-4 font-medium">Release</th>
            <th scope="col" class="py-2 pr-4 font-medium text-right">Forecast</th>
            <th scope="col" class="py-2 font-medium text-right">Previous</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-rule" data-policy-events></tbody>
      </table>
    </div>
  </div>

  <p class="mt-6 text-xs text-ink-3">
    Sources: <a class="underline" href="https://www.rbi.org.in/" rel="noopener">Reserve Bank of India</a>;
    <a class="underline" href="https://esankhyiki.mospi.gov.in/" rel="noopener">MoSPI</a> (CPI, WPI, IIP, GDP, PLFS);
    calendar from <a class="underline" href="https://www.forexfactory.com/calendar" rel="noopener">Forex Factory</a>.
    Growth and inflation are year on year.
  </p>
  <noscript><p class="mt-4 text-sm text-ink-2">Turn on JavaScript to see macro data, policy rates and the calendar.</p></noscript>
</section>

<script>
  import { loadPolicy, formatIst, formatRate, formatIndicator } from '../lib/policy.js';

  const el = (tag, className, text) => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  // Levels are shown unsigned; growth and inflation carry a sign.
  const LEVELS = new Set(['unemployment']);

  function tile(label, value, note) {
    const box = el('div');
    box.append(el('dt', 'text-xs text-ink-3', label), el('dd', 'mt-1 font-serif text-2xl num', value), el('dd', 'text-xs text-ink-3 num', note));
    return box;
  }

  function renderTiles(root, data) {
    const tiles = (data?.macro?.indicators ?? []).map((i) => tile(i.label, formatIndicator(i.value, { signed: !LEVELS.has(i.key) }), i.period));
    root.querySelector('[data-macro-tiles]')
      .replaceChildren(...(tiles.length ? tiles : [el('div', 'col-span-full text-sm text-ink-3', 'India macro data is unavailable right now.')]));
  }

  function renderRbi(root, rbi) {
    const rows = rbi.rates.map((rate) => {
      const row = el('div', 'flex justify-between py-2');
      row.append(el('dt', 'text-ink-2', rate.label), el('dd', 'font-mono num font-medium', formatRate(rate.value)));
      return row;
    });
    if (rbi.usdInr) {
      const row = el('div', 'flex justify-between py-2');
      row.append(el('dt', 'text-ink-2', 'USD/INR (RBI)'), el('dd', 'font-mono num font-medium', rbi.usdInr.toFixed(4)));
      rows.push(row);
    }
    root.querySelector('[data-policy-rates]').replaceChildren(...rows);
    root.querySelector('[data-policy-rbi-label]').textContent = `Checked ${formatIst(rbi.fetchedAt)}`;

    const releases = rbi.releases.map((release) => {
      const li = el('li', 'py-2');
      const link = el('a', 'headline-link text-ink', release.title);
      link.href = release.href;
      link.rel = 'noopener';
      li.append(link, el('div', 'text-xs text-ink-3 num', formatIst(release.time)));
      return li;
    });
    root.querySelector('[data-policy-releases]')
      .replaceChildren(...(releases.length ? releases : [el('li', 'py-2 text-ink-3', 'No recent policy releases.')]));
  }

  function renderCalendar(root, calendar, now) {
    const rows = calendar.events.map((event) => {
      const tr = el('tr', event.time < now ? 'align-top text-ink-3' : 'align-top');
      const release = el('td', 'py-3 pr-4');
      release.append(el('span', 'font-mono text-xs text-ink-3 mr-1.5', event.country), el('span', 'font-medium', event.title));
      tr.append(
        el('td', 'py-3 pr-4 whitespace-nowrap num', formatIst(event.time).replace(' IST', '')),
        release,
        el('td', 'py-3 pr-4 text-right font-mono num', event.forecast),
        el('td', 'py-3 text-right font-mono num', event.previous),
      );
      return tr;
    });
    const empty = el('tr');
    empty.append(Object.assign(el('td', 'py-3 text-ink-3', 'No high-impact releases this week.'), { colSpan: 4 }));
    root.querySelector('[data-policy-events]').replaceChildren(...(rows.length ? rows : [empty]));
    root.querySelector('[data-policy-calendar-label]').textContent = `Checked ${formatIst(calendar.fetchedAt)} · past releases greyed`;
  }

  async function render() {
    const root = document.getElementById('policy');
    if (!root) return;
    const data = await loadPolicy();
    renderTiles(root, data);
    if (data?.rbi) renderRbi(root, data.rbi);
    else root.querySelector('[data-policy-rbi-label]').textContent = 'RBI rates are unavailable right now.';
    if (data?.calendar) renderCalendar(root, data.calendar, Date.now());
    else root.querySelector('[data-policy-calendar-label]').textContent = 'The calendar is unavailable right now.';
  }

  render();
</script>
