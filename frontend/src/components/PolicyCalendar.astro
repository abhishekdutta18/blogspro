---
/**
 * PolicyCalendar — upcoming and recent macro releases as a plain table,
 * plus the desk's read on RBI policy.
 * "Actual" is only shown for releases dated on or before the snapshot date;
 * a future release cannot have an actual print.
 */
import { highImpactEvents, macroRadar, marketsAsOf } from '../data/marketData';
import { dateValue, formatIsoDate, isAfter } from '../lib/format';

const events = [...highImpactEvents].sort((a, b) => dateValue(a.date) - dateValue(b.date));
const odds = macroRadar.rbiProbability;
---

<section id="policy" class="pt-16 scroll-mt-6" aria-labelledby="policy-heading">
  <div class="section-head">
    <h2 id="policy-heading" class="section-title">Policy calendar</h2>
    <span class="text-sm text-ink-3">As of {formatIsoDate(marketsAsOf)}</span>
  </div>

  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
    <div>
      <h3 class="font-serif text-xl font-semibold">RBI: {macroRadar.policyRegime}</h3>
      <p class="mt-2 text-ink-2 leading-relaxed">{macroRadar.rbiStance}</p>

      <div class="mt-6">
        <div class="text-xs uppercase tracking-[0.14em] text-ink-3">Desk view, next MPC</div>
        <div class="mt-2 flex h-2 w-full overflow-hidden bg-sunk" role="img"
          aria-label={`Hold ${odds.hold}%, cut ${odds.cut}%, hike ${odds.hike}%`}>
          <div class="bg-ink" style={`width:${odds.hold}%`}></div>
          <div class="bg-up" style={`width:${odds.cut}%`}></div>
          <div class="bg-down" style={`width:${odds.hike}%`}></div>
        </div>
        <dl class="mt-2 flex gap-5 text-sm num">
          <div><dt class="inline text-ink-3">Hold </dt><dd class="inline font-medium">{odds.hold}%</dd></div>
          <div><dt class="inline text-ink-3">Cut </dt><dd class="inline font-medium text-up">{odds.cut}%</dd></div>
          <div><dt class="inline text-ink-3">Hike </dt><dd class="inline font-medium text-down">{odds.hike}%</dd></div>
        </dl>
      </div>

      <p class="mt-6 text-sm text-ink-2 leading-relaxed">
        <span class="text-ink-3">INR:</span> {macroRadar.inrStress}
      </p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-rule-strong text-left text-xs uppercase tracking-wider text-ink-3">
            <th scope="col" class="py-2 pr-4 font-medium">Date</th>
            <th scope="col" class="py-2 pr-4 font-medium">Release</th>
            <th scope="col" class="py-2 pr-4 font-medium text-right">Prior</th>
            <th scope="col" class="py-2 pr-4 font-medium text-right">Consensus</th>
            <th scope="col" class="py-2 font-medium text-right">Actual</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-rule">
          {events.map(event => {
            const upcoming = isAfter(event.date, marketsAsOf);
            return (
              <tr class="align-top">
                <td class="py-3 pr-4 whitespace-nowrap text-ink-2 num">{event.date}</td>
                <td class="py-3 pr-4">
                  <span class="font-mono text-xs text-ink-3 mr-1.5">{event.country}</span>
                  <span class="font-medium">{event.title}</span>
                </td>
                <td class="py-3 pr-4 text-right font-mono num">{event.previous}</td>
                <td class="py-3 pr-4 text-right font-mono num">{event.forecast}</td>
                <td class="py-3 text-right font-mono num">
                  {upcoming ? <span class="text-ink-3" title="Not yet released">—</span> : event.actual}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>
</section>
