---
/**
 * Header — typeset masthead with section navigation.
 * Uses a text wordmark instead of the raster logo so it reads in light and dark mode.
 */
import { siteConfig } from '../data/siteConfig';
---

<header class="w-full border-b border-rule">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-end justify-between gap-6 pt-6 pb-4">
      <a href="/" class="group" aria-label={`${siteConfig.name} home`}>
        <span class="block font-serif text-[2rem] sm:text-[2.4rem] font-semibold leading-none tracking-tight">
          {siteConfig.name}
        </span>
        <span class="mt-1.5 block text-xs text-ink-3 tracking-wide">{siteConfig.tagline}</span>
      </a>
      <div class="shrink-0 flex items-center gap-5 text-sm">
        <a href="/login.html" class="text-ink-2 hover:text-ink underline-offset-4 hover:underline">Sign in</a>
        <a href="/#newsletter" class="font-medium text-accent underline-offset-4 hover:underline">Subscribe</a>
      </div>
    </div>

    <nav aria-label="Sections" class="-mx-4 sm:mx-0 overflow-x-auto border-t border-rule">
      <ul class="flex gap-6 px-4 sm:px-0 py-2.5 text-sm text-ink-2 whitespace-nowrap">
        {siteConfig.nav.map(item => (
          <li>
            <a href={item.href} class="hover:text-ink hover:underline underline-offset-4">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
