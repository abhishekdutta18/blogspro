---
/**
 * MarketsTable — cross-asset snapshot with asset-class tabs.
 * Built from a dated snapshot; in the browser, /data/markets.json replaces the figures and the label
 * (see lib/markets.js). Without it the snapshot stays, labelled with its own date.
 */
import { marketAssets, marketsAsOf, type MarketAsset } from '../data/marketData';
import { formatIsoDate } from '../lib/format';

const CLASSES: Array<{ id: 'all' | MarketAsset['category']; label: string }> = [
  { id: 'all', label: 'All' },
  { id: 'indices', label: 'Indices' },
  { id: 'forex', label: 'Currencies' },
  { id: 'bonds', label: 'Rates' },
  { id: 'commodities', label: 'Commodities' },
  { id: 'crypto', label: 'Crypto' }
];
---

<section id="markets" class="pt-16 scroll-mt-6" aria-labelledby="markets-heading">
  <div class="section-head">
    <h2 id="markets-heading" class="section-title">Markets</h2>
    <span class="text-sm text-ink-3" data-markets-label>Close, {formatIsoDate(marketsAsOf)}</span>
  </div>

  <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm mb-4" role="group" aria-label="Filter by asset class">
    {CLASSES.map((assetClass, index) => (
      <button type="button" class="market-filter" data-class={assetClass.id} aria-pressed={String(index === 0)}>
        {assetClass.label}
      </button>
    ))}
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-rule-strong text-left text-xs uppercase tracking-wider text-ink-3">
          <th scope="col" class="py-2 pr-4 font-medium">Instrument</th>
          <th scope="col" class="py-2 pr-4 font-medium text-right">Last</th>
          <th scope="col" class="py-2 pr-4 font-medium text-right">Change</th>
          <th scope="col" class="py-2 pr-4 font-medium text-right hidden sm:table-cell">Day range</th>
          <th scope="col" class="py-2 font-medium text-right hidden md:table-cell">Open</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-rule">
        {marketAssets.map(asset => (
          <tr class="market-row" data-class={asset.category} data-market-symbol={asset.symbol}>
            <td class="py-2.5 pr-4">
              <span class="font-medium">{asset.name}</span>
              <span class="ml-2 font-mono text-xs text-ink-3">{asset.symbol}</span>
            </td>
            <td class="py-2.5 pr-4 text-right font-mono num" data-field="price">{asset.price}</td>
            <td class={`py-2.5 pr-4 text-right font-mono num ${asset.isPositive ? 'text-up' : 'text-down'}`} data-field="change">{asset.change}</td>
            <td class="py-2.5 pr-4 text-right font-mono num text-ink-2 hidden sm:table-cell" data-field="range">{asset.low} – {asset.high}</td>
            <td class="py-2.5 text-right font-mono num text-ink-2 hidden md:table-cell" data-field="open">{asset.open}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .market-filter {
    color: var(--ink-2);
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
  }
  .market-filter:hover { color: var(--ink); }
  .market-filter[aria-pressed='true'] {
    color: var(--ink);
    font-weight: 600;
    border-bottom-color: var(--accent);
  }
</style>

<script>
  import { loadLiveMarkets } from '../lib/markets.js';
  loadLiveMarkets();
</script>

<script is:inline>
  (() => {
    const filters = document.querySelectorAll('.market-filter');
    const rows = document.querySelectorAll('.market-row');
    filters.forEach(button => {
      button.addEventListener('click', () => {
        const selected = button.dataset.class || 'all';
        filters.forEach(b => b.setAttribute('aria-pressed', String(b === button)));
        rows.forEach(row => {
          row.hidden = selected !== 'all' && row.dataset.class !== selected;
        });
      });
    });
  })();
</script>
