---
/**
 * Briefings page — every hourly briefing the pipeline has published, newest first.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import BriefingFeed from '../components/BriefingFeed.astro';
import { siteConfig } from '../data/siteConfig';
---

<BaseLayout title={`Hourly briefings — ${siteConfig.name}`} description="Hourly institutional market briefings: liquidity, rates, credit and policy, published every hour.">
  <BriefingFeed id="briefings" heading="Hourly briefings" limit={200} />
</BaseLayout>
