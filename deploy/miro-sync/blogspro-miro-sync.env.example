# /etc/blogspro-miro-sync.env (owner root, group blogspro-miro-sync, mode 0640)
# 8787 is taken by blogspro-api.
PORT=8788
MIRO_SYNC_HOST=127.0.0.1
MIRO_SYNC_DATA_DIR=/var/lib/blogspro-miro-sync
# Shared with every pusher (pulse/mirofish worker secret, pipeline env). Generate: openssl rand -hex 32
# Gates /push, /snapshot and catch-all writes. Reads, /terminal and the terminal's own /sync and /archive stay open.
MIRO_SYNC_TOKEN=
# Off-box backups through saveSnapshot (GCS). Needs the service account at
# /opt/blogspro-miro-sync/knowledge/firebase-service-account.json (root:blogspro-miro-sync, 0640).
# Leave the bucket empty to keep state on local disk only.
FIREBASE_PROJECT_ID=blogspro-ai
FIREBASE_STORAGE_BUCKET=
MIRO_SYNC_BACKUP_MINUTES=30
