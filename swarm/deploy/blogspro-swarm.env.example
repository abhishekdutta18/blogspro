# /etc/blogspro-swarm.env (owner root, group blogspro-api, mode 0640)
# The swarm calls AI providers only through the blogspro-ai-proxy worker, which holds
# the provider keys as Cloudflare secrets. No provider key belongs on the VPS.
SWARM_PROXY_URL=https://blogspro-ai-proxy.abhishek-dutta1996.workers.dev
# Same value as the worker's SWARM_PROXY_TOKEN secret.
SWARM_PROXY_TOKEN=

# Optional overrides
# SWARM_PROVIDER_ORDER=groq,openrouter,mistral,sambanova
# SWARM_GROQ_MODEL=openai/gpt-oss-120b
# SWARM_DB_PATH=/var/lib/blogspro-api/blogspro.db
# SWARM_MIN_HEADLINES=8
# SWARM_HOURLY_RETENTION=168
